{
  "manifest_version": 3,
  "name": "Mainlander Shield",
  "version": "0.1.0",
  "description": "Defensive browser fingerprint surface normalizer and audit companion for Mainlander.",
  "permissions": ["storage", "declarativeNetRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mainlander Shield"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
